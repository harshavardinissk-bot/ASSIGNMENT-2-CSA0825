from functools import lru_cache
import sys
calls=0
def ways_naive(n):
    global calls; calls+=1
    if n<=1: return 1
    return ways_naive(n-1)+ways_naive(n-2)
@lru_cache(None)
def ways_memo(n):
    global calls; calls+=1
    if n<=1: return 1
    return ways_memo(n-1)+ways_memo(n-2)
def ways_loop(n):
    a=b=1
    for _ in range(2,n+1): a,b=b,a+b
    return a
for n in range(1,7): print(n,ways_memo(n))
for n in (10,20,25,30):
    calls=0; ways_naive(n); plain=calls
    ways_memo.cache_clear(); calls=0; ways_memo(n); memo=calls
    print(n,plain,memo)
ways_memo.cache_clear()
try: ways_memo(1000)
except RecursionError: print("memo(1000): RecursionError; limit",sys.getrecursionlimit())
print("loop 1000 digits:",len(str(ways_loop(1000))))
