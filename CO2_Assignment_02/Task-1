def separate(units,card,age80):
    results=[]
    if units<=100: results.append("full")
    if 101<=units<=200 and card: results.append("partial")
    if units>200 and age80: results.append("elderly exception")
    if not results: results.append("none")
    return results
def chained(units,card,age80):
    if units<=100: return "full"
    elif 101<=units<=200 and card: return "partial"
    elif units>200 and age80: return "elderly exception"
    else: return "none"
cases=[(99,False,False),(100,False,False),(101,False,False),(101,True,False),
       (150,True,False),(200,True,False),(201,False,False),(201,False,True)]
for x in cases: print(x,separate(*x),chained(*x))
