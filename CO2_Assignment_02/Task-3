def normalise(text):
    return text.strip().replace(" ","").replace("-","").upper()
def is_valid(reg):
    n=len(reg)
    return (n in (9,10) and reg[:2].isalpha() and reg[2:4].isdigit()
            and len(reg[4:-4]) in (1,2) and reg[4:-4].isalpha()
            and reg[-4:].isdigit())
def receipt(reg):
    if not is_valid(reg): raise ValueError("invalid registration")
    return f"{reg[:2]} {reg[2:4]} {reg[4:-4]} {reg[-4:]}"
for raw in ["tn 09 ab 1234","KA-01-M-0007","TN9AB1234","TN 22 1234 AB","MH12P1234","1N09AB1234"]:
    r=normalise(raw); print(f"{raw:15} -> {r:11} {'valid' if is_valid(r) else 'INVALID'}")
print(receipt("tn 09 ab 1234"))
