def add_item_buggy(item,order=[]):
    order.append(item); return order
def add_item(item,order=None):
    if order is None: order=[]
    order.append(item); return order
print(add_item_buggy("Tea"),add_item_buggy("Vada"))
print(add_item("Tea"),add_item("Vada"),add_item("Coffee"))
print("defaults:",add_item_buggy.__defaults__)
def bill(items,prices,rate=0.05):
    total=sum(prices[x] for x in items); gst=total*rate
    return total,gst
def make_counter():
    count=0
    def increment():
        nonlocal count; count+=1; return count
    return increment
counter=make_counter(); print(bill(["Tea","Vada"],{"Tea":10,"Vada":20}),counter(),counter())
visits=0
def record_visit():
    global visits
    visits+=1
record_visit(); print("global visits:",visits)
